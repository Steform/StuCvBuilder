{% extends 'base.html.twig' %}

{% set currentLocale = app.request.locale|default('fr') %}
{% set seoRobots = 'noindex, nofollow' %}
{% block title %}{{ 'security.reset_password.meta.title'|trans({}, 'messages', currentLocale) }}{% endblock %}

{% block body %}
    <div class="row justify-content-center">
        <div class="col-12 col-md-6 col-lg-5">
            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <h1 class="h4 mb-3">{{ 'security.reset_password.title'|trans({}, 'messages', currentLocale) }}</h1>

                    {% if not tokenValid %}
                        <p class="text-muted">{{ 'security.reset_password.invalid_or_expired'|trans({}, 'messages', currentLocale) }}</p>
                        <a class="btn btn-primary w-100" href="{{ path('forgot_password') }}">{{ 'security.reset_password.request_new_link'|trans({}, 'messages', currentLocale) }}</a>
                    {% else %}
                        <p class="text-muted">{{ 'security.reset_password.subtitle'|trans({}, 'messages', currentLocale) }}</p>

                        <form method="post" action="{{ path('reset_password_submit', {token: token}) }}">
                            <input type="hidden" name="_csrf_token" value="{{ csrf_token(csrfResetPassword) }}">
                            <div class="mb-3">
                                <label for="password" class="form-label">{{ 'security.reset_password.password'|trans({}, 'messages', currentLocale) }}</label>
                                <input id="password" name="password" type="password" class="form-control" required autocomplete="new-password">
                            </div>
                            <div class="mb-3">
                                <label for="password_confirm" class="form-label">{{ 'security.reset_password.password_confirm'|trans({}, 'messages', currentLocale) }}</label>
                                <input id="password_confirm" name="password_confirm" type="password" class="form-control" required autocomplete="new-password">
                            </div>
                            <button type="submit" class="btn btn-primary w-100">{{ 'security.reset_password.submit'|trans({}, 'messages', currentLocale) }}</button>
                        </form>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
