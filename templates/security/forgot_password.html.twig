{% extends 'base.html.twig' %}

{% set currentLocale = app.request.locale|default('fr') %}
{% set seoRobots = 'noindex, nofollow' %}
{% block title %}{{ 'security.forgot_password.meta.title'|trans({}, 'messages', currentLocale) }}{% endblock %}

{% block body %}
    <div class="row justify-content-center">
        <div class="col-12 col-md-6 col-lg-5">
            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <h1 class="h4 mb-3">{{ 'security.forgot_password.title'|trans({}, 'messages', currentLocale) }}</h1>
                    <p class="text-muted">{{ 'security.forgot_password.subtitle'|trans({}, 'messages', currentLocale) }}</p>

                    <form method="post" action="{{ path('forgot_password_submit') }}">
                        <input type="hidden" name="_csrf_token" value="{{ csrf_token(csrfForgotPassword) }}">
                        <div class="mb-3">
                            <label for="email" class="form-label">{{ 'security.forgot_password.email'|trans({}, 'messages', currentLocale) }}</label>
                            <input id="email" name="email" type="email" class="form-control" placeholder="{{ 'security.forgot_password.email_placeholder'|trans({}, 'messages', currentLocale) }}" required>
                        </div>
                        <button type="submit" class="btn btn-primary w-100">{{ 'security.forgot_password.submit'|trans({}, 'messages', currentLocale) }}</button>
                    </form>

                    <p class="mt-3 mb-0 text-center">
                        <a href="{{ path('app_login') }}">{{ 'security.forgot_password.back_to_login'|trans({}, 'messages', currentLocale) }}</a>
                    </p>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
