{% extends 'base.html.twig' %}

{% set currentLocale = app.request.locale|default('fr') %}
{% set seoRobots = 'noindex, nofollow' %}
{% block title %}{{ 'security.forced_password_change.meta.title'|trans({}, 'messages', currentLocale) }}{% endblock %}

{% block body %}
    <div class="row justify-content-center">
        <div class="col-12 col-md-6 col-lg-5">
            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <h1 class="h4 mb-3">{{ 'security.forced_password_change.title'|trans({}, 'messages', currentLocale) }}</h1>
                    <p class="text-muted">{{ 'security.forced_password_change.subtitle'|trans({}, 'messages', currentLocale) }}</p>

                    <form method="post" action="{{ path('forced_password_change_submit') }}">
                        <input type="hidden" name="_csrf_token" value="{{ csrf_token(csrfForcedPasswordChange) }}">
                        <div class="mb-3">
                            <label for="password" class="form-label">{{ 'security.forced_password_change.password'|trans({}, 'messages', currentLocale) }}</label>
                            <input id="password" name="password" type="password" class="form-control" required autocomplete="new-password">
                        </div>
                        <div class="mb-3">
                            <label for="password_confirm" class="form-label">{{ 'security.forced_password_change.password_confirm'|trans({}, 'messages', currentLocale) }}</label>
                            <input id="password_confirm" name="password_confirm" type="password" class="form-control" required autocomplete="new-password">
                        </div>
                        <button type="submit" class="btn btn-primary w-100">{{ 'security.forced_password_change.submit'|trans({}, 'messages', currentLocale) }}</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
