{% extends 'base_cv_access.html.twig' %}
{% set currentLocale = currentLocale|default(app.request.locale|default('fr')) %}

{% block title %}{{ 'cv.access_denied.meta.title'|trans({}, 'messages', currentLocale) }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link href="{{ asset('css/cv-access-denied.css') }}" rel="stylesheet">
{% endblock %}

{% block main_container_class %}cv-access-denied-page container py-5{% endblock %}

{% block body %}
    <section class="cv-access-denied-page__card card shadow-sm mx-auto">
        <div class="card-body text-center p-4 p-md-5">
            <div class="cv-access-denied-page__icon mb-3" aria-hidden="true">
                <i class="bi bi-shield-lock"></i>
            </div>
            <h1 class="h3 mb-3">{{ 'cv.access_denied.title'|trans({}, 'messages', currentLocale) }}</h1>
            <p class="text-muted mb-0">{{ 'cv.access_denied.description'|trans({}, 'messages', currentLocale) }}</p>
        </div>
    </section>
{% endblock %}
